# Environment Configuration for Kids Animation Pipeline

# Data Storage Location
DATA_DIR=C:/Users/pshij/Downloads/default

# Ollama LLM Backend
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Worker Service
WORKER_PORT=8000

# Video Output Settings (Phase 3+)
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=10M
# Animation quality (used by blender_animation.py)
VIDEO_CRF=18
VIDEO_PRESET=slow

# Story Generation
STORY_MIN_WORDS=1900
STORY_MAX_WORDS=2300

# YouTube (Phase 6)
# Set to true to SKIP YouTube uploads during testing
GENERATE_ONLY=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Scheduling (Phase 5)
DAILY_VIDEO_LIMIT=1
SCHEDULE_TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
