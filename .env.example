# Environment Configuration for Kids Animation Pipeline

# Ollama LLM Backend
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Worker Service
WORKER_PORT=8000

# Video Output Settings (Phase 3+)
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2500k

# Story Generation
STORY_MIN_WORDS=250
STORY_MAX_WORDS=500

# YouTube (Phase 6)
# Set to true to SKIP YouTube uploads during testing
GENERATE_ONLY=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Scheduling (Phase 5)
DAILY_VIDEO_LIMIT=1
SCHEDULE_TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
