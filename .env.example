# Environment Configuration for Kids Animation Pipeline

DATA_DIR=./data

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=slow

# Generative movie renderer (Runway Dev)
RUNWAY_VIDEO_MODEL=wan3
RUNWAY_VIDEO_RESOLUTION=720p
RUNWAY_VIDEO_RATIO=1280:720
RUNWAY_VIDEO_DURATION=17
# RUNWAYML_API_SECRET must be stored as a GitHub Actions secret.

# 25-30 minute episode target
EPISODE_MIN_SECONDS=1500
EPISODE_MAX_SECONDS=1800

# YouTube publishing is OFF by default.
YOUTUBE_UPLOAD=false
YOUTUBE_PRIVACY=private
# In GitHub Actions, provide the OAuth authorized-user JSON as the
# YOUTUBE_TOKEN_JSON repository/environment secret. Never commit it.
