DATA_DIR=./data
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=18
VIDEO_PRESET=slow

# Free local 3D renderer
BLENDER_RENDER_FPS=6
BLENDER_RENDER_WIDTH=640
BLENDER_RENDER_HEIGHT=360

# Free offline narration
TTS_ENGINE=espeak-ng
TTS_VOICE=en-us
TTS_RATE=155
TTS_PITCH=50

# 25-30 minute episode target
EPISODE_MIN_SECONDS=1500
EPISODE_MAX_SECONDS=1800

# YouTube publishing is OFF by default.
YOUTUBE_UPLOAD=false
YOUTUBE_PRIVACY=private
